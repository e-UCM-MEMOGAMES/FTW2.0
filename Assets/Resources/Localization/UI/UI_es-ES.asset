  m_TableData:
  - m_Id: 1191103885312
    m_Localized: Nivel
    m_Metadata:
      m_Items: []
  - m_Id: 1421660581888
    m_Localized: Volver
    m_Metadata:
      m_Items: []
  - m_Id: 2207668957184
    m_Localized: Puntuacion
    m_Metadata:
      m_Items: []
  - m_Id: 2549534093312
    m_Localized: Has llegado a tu destino
    m_Metadata:
      m_Items: []
  - m_Id: 2585038876672
    m_Localized: Haz click para continuar
    m_Metadata:
      m_Items: []
  - m_Id: 2667964461056
    m_Localized: "Esta barra indica la energ\xEDa restante del coche. Disminuir\xE1
      cada vez que se mueva"
    m_Metadata:
      m_Items: []
  - m_Id: 2936525746176
    m_Localized: "Aqu\xED puedes ver tu consumo.\nIntenta llegar a la meta antes
      de agotarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 3099042443264
    m_Localized: "Haz clic en las flechas rojas para elegir la direcci\xF3n del coche."
    m_Metadata:
      m_Items: []
  - m_Id: 3190365024256
    m_Localized: tambien puedes cambiar la perspectiva pulsando este boton
    m_Metadata:
      m_Items: []
  - m_Id: 3293125472256
    m_Localized: "Haz clic en el mapa para cerrarlo.\nEl n\xFAmero indica las veces
      que puedes consultarlo"
    m_Metadata:
      m_Items: []
  - m_Id: 3439280189440
    m_Localized: "Coloca el rat\xF3n sobre los edificios para saber qu\xE9 son."
    m_Metadata:
      m_Items: []
  - m_Id: 3508679143424
    m_Localized: "Aqu\xED puedes ver en amarillo el mejor camino hasta el objetivo."
    m_Metadata:
      m_Items: []
  - m_Id: 3632025235456
    m_Localized: "La flecha az\xFAl se\xF1ala tu posici\xF3n. La flecha rosa indica
      d\xF3nde debes llegar."
    m_Metadata:
      m_Items: []
  - m_Id: 3787541639168
    m_Localized: "Este es el mapa de la ciudad. Tendr\xE1s que memorizar la ruta
      hasta tu destino para ganar."
    m_Metadata:
      m_Items: []
  - m_Id: 378826388598784
    m_Localized: Gastar menos del 50% de gasolina
    m_Metadata:
      m_Items: []
  - m_Id: 378990167781376
    m_Localized: No haber consultado el mapa
    m_Metadata:
      m_Items: []
  - m_Id: 379021444706304
    m_Localized: Tomar el camino mas corto
    m_Metadata:
      m_Items: []
  - m_Id: 380423084634112
    m_Localized: Tienes que ir al hotel a recoger a tu amigo.
    m_Metadata:
      m_Items: []
  - m_Id: 381341813370880
    m_Localized: Reintentar
    m_Metadata:
      m_Items: []
